# Copy to .env at repository root and configure your own provider values.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
GROQ_TEXT_MODEL=
# Vision stays OFF without explicit verified-model opt-in.
GROQ_VISION_MODEL=
ENABLE_VISION_DIAGNOSIS=false
GROQ_VISION_VERIFIED=false
MAX_IMAGE_SIZE_MB=5
# Optional (client-side public URL only; Vite dev proxy works without it)
VITE_API_BASE_URL=
